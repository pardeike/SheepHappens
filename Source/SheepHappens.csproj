<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<ProjectGuid>$(ProjectGuid)</ProjectGuid>
		<RootNamespace>$(ModFileName)</RootNamespace>
		<AssemblyName>$(ModFileName)</AssemblyName>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<OutputPath>..\1.7\Assemblies\</OutputPath>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <GenerateDependencyFile>false</GenerateDependencyFile>
        <NoWarn>$(NoWarn);NU1701</NoWarn>
        <PythonCommand Condition="'$(PythonCommand)' == ''">python3</PythonCommand>
        <BuildBridgeTools Condition="'$(BuildBridgeTools)' == ''">true</BuildBridgeTools>
        <GlobalBridgeToolsDir Condition="'$(RIMWORLD_MOD_DIR)' != ''">$([MSBuild]::NormalizeDirectory('$(RIMWORLD_MOD_DIR)\..\BridgeTools'))</GlobalBridgeToolsDir>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<Version>$(ModVersion)</Version>
		<AssemblyVersion>$(ModVersion)</AssemblyVersion>
		<FileVersion>$(ModVersion)</FileVersion>
		<PackageVersion>$(ModVersion)</PackageVersion>
		<InformationalVersion>$(ModVersion)</InformationalVersion>
		<Copyright>Copyright Andreas Pardeike</Copyright>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DebugSymbols>false</DebugSymbols>
		<Optimize>true</Optimize>
		<DebugType>none</DebugType>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DebugSymbols>true</DebugSymbols>
		<DefineConstants>RW17;TRACE;DEBUG</DefineConstants>
		<Optimize>false</Optimize>
		<DebugType>embedded</DebugType>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="BridgeTools\**\*.cs" />
        <Content Include="..\Directory.Build.props">
			<Link>%(Filename)%(Extension)</Link>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Brrainz.RimWorld.CrossPromotion" Version="1.1.2" GeneratePathProperty="true" ExcludeAssets="runtime" />
		<PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.5021-unstable" GeneratePathProperty="true" />
		<PackageReference Include="Lib.Harmony.Ref" Version="3.0.0-rc.8" />
		<PackageReference Include="TaskPubliciser" Version="1.0.3" />
	</ItemGroup>

	<Target Name="PrepareRimWorldReferences" BeforeTargets="ResolveAssemblyReferences">
		<PropertyGroup>
			<AssemblyCSharp>$(PkgKrafs_Rimworld_Ref)\ref\net10.0\Assembly-CSharp.dll</AssemblyCSharp>
			<PubliciseOutputPath>$(MSBuildProjectDirectory)/obj/publicised/</PubliciseOutputPath>
			<AssemblyCSharp_Publicised>$(PubliciseOutputPath)Assembly-CSharp_publicised.dll</AssemblyCSharp_Publicised>
		</PropertyGroup>
		<MakeDir Directories="$(PubliciseOutputPath)" />
		<Publicise TargetAssemblyPath="$(AssemblyCSharp)" OutputPath="$(PubliciseOutputPath)" />
		<ItemGroup>
			<Reference Include="$(AssemblyCSharp_Publicised)">
				<SpecificVersion>false</SpecificVersion>
				<HintPath>$(AssemblyCSharp_Publicised)</HintPath>
				<Implicit>true</Implicit>
				<Private>false</Private>
			</Reference>
		</ItemGroup>
	</Target>

	<Target Name="UpdateReferences" AfterTargets="ResolveLockFileReferences">
		<Message Importance="High" Text="Remove References ..." />
		<ItemGroup>
			<Reference Remove="$(PkgKrafs_Rimworld_Ref)\ref\net10.0\Assembly-CSharp.dll" />
		</ItemGroup>
	</Target>

	<PropertyGroup>
		<Company>Brrainz</Company>
		<Authors>Andreas Pardeike</Authors>
		<Description></Description>
		<PackageProjectUrl>$(Repository)</PackageProjectUrl>
		<RepositoryUrl>$(Repository)</RepositoryUrl>
		<Product>$(ModName)</Product>
	</PropertyGroup>


  <Target Name="ValidateLocalBuild" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <ExpectedOutputDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '../1.7/Assemblies/'))</ExpectedOutputDirectory>
      <CurrentOutputDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(OutputPath)'))</CurrentOutputDirectory>
      <CurrentTargetDirectory>$([MSBuild]::NormalizeDirectory('$(TargetDir)'))</CurrentTargetDirectory>
    </PropertyGroup>
    <Error Condition="'$(CurrentOutputDirectory)' != '$(ExpectedOutputDirectory)' Or '$(CurrentTargetDirectory)' != '$(ExpectedOutputDirectory)'" Text="Build output must stay in 1.7/Assemblies. Older payloads are frozen." />
    <Error Condition="'$(PlatformTarget)' != 'AnyCPU'" Text="RimWorld 1.7 requires the AnyCPU build." />
    <Error Condition="'$(BuildBridgeTools)' != 'true' And '$(BuildBridgeTools)' != 'false'" Text="BuildBridgeTools must be true or false." />
    <Exec Command="&quot;$(PythonCommand)&quot; &quot;$(MSBuildProjectDirectory)/../scripts/rimworld_deploy_guard.py&quot; verify-legacy" />
    <Exec Condition="'$(RIMWORLD_MOD_DIR)' != ''" Command="&quot;$(PythonCommand)&quot; &quot;$(MSBuildProjectDirectory)/../scripts/rimworld_deploy_guard.py&quot; check-deploy &quot;$(RIMWORLD_MOD_DIR)&quot; $(BuildBridgeTools) &quot;$(GlobalBridgeToolsDir)&quot;" />
  </Target>
  <Target Name="BuildCompanion" Condition="'$(BuildBridgeTools)' == 'true'">
    <Exec Command="dotnet restore &quot;$(MSBuildProjectDirectory)/BridgeTools/SheepHappens.BridgeTools.csproj&quot; --nologo --verbosity quiet" />
    <MSBuild Projects="$(MSBuildProjectDirectory)/BridgeTools/SheepHappens.BridgeTools.csproj" Targets="Build" Properties="Configuration=$(Configuration);Platform=$(Platform);SheepHappensAssemblyPath=$(TargetPath)" />
  </Target>
  <Target Name="PostBuildAction" AfterTargets="Build" DependsOnTargets="BuildCompanion">
    <XmlPoke XmlInputPath="$(MSBuildProjectDirectory)/../About/About.xml" Query="//ModMetaData/modVersion" Value="$(ModVersion)" />
    <XmlPoke XmlInputPath="$(MSBuildProjectDirectory)/../About/Manifest.xml" Query="//Manifest/version" Value="$(ModVersion)" />
    <Copy SourceFiles="$(PkgBrrainz_RimWorld_CrossPromotion)/lib/net472/CrossPromotion.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <Exec Command="&quot;$(PythonCommand)&quot; &quot;$(MSBuildProjectDirectory)/../scripts/rimworld_deploy_guard.py&quot; verify-legacy" />
  </Target>
  <Target Name="CopyToRimworld" AfterTargets="PostBuildAction" Condition="'$(RIMWORLD_MOD_DIR)' != ''">
    <Exec Command="&quot;$(PythonCommand)&quot; &quot;$(MSBuildProjectDirectory)/../scripts/rimworld_deploy_guard.py&quot; deploy &quot;$(RIMWORLD_MOD_DIR)&quot; $(BuildBridgeTools) &quot;$(GlobalBridgeToolsDir)&quot;" />
  </Target>
  <Target Name="PackageMod" DependsOnTargets="Build">
    <Exec Command="&quot;$(PythonCommand)&quot; &quot;$(MSBuildProjectDirectory)/../scripts/rimworld_deploy_guard.py&quot; package" />
  </Target>
</Project>
