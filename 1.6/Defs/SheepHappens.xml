<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ApparelLayerDef>
		<defName>SheepDisguiseShell</defName>
		<label>sheep disguise shell</label>
		<drawOrder>250</drawOrder>
	</ApparelLayerDef>

	<ThingDef ParentName="ApparelBase">
		<defName>DisguiseMask</defName>
		<label>sheep disguise mask</label>
		<selectable>false</selectable>
		<alwaysHaulable>false</alwaysHaulable>
		<smeltable>false</smeltable>
		<thingCategories>
			<li>Headgear</li>
		</thingCategories>
		<statBases>
			<Mass>0.1</Mass>
		</statBases>
		<graphicData>
			<texPath>DisguiseMask/DisguiseMask</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>1.3</drawSize>
		</graphicData>
		<apparel>
			<wornGraphicPath>DisguiseMask/DisguiseMask</wornGraphicPath>
			<bodyPartGroups>
				<li>FullHead</li>
			</bodyPartGroups>
			<renderSkipFlags>
				<li>Hair</li>
				<li>Beard</li>
				<li>Eyes</li>
			</renderSkipFlags>
			<drawData>
				<dataNorth>
					<layer>-3</layer>
				</dataNorth>
			</drawData>
			<countsAsClothingForNudity>false</countsAsClothingForNudity>
			<layers>
				<li>Overhead</li>
			</layers>
		</apparel>
	</ThingDef>

	<ThingDef ParentName="ApparelBase">
		<defName>DisguiseCostume</defName>
		<label>sheep disguise costume</label>
		<selectable>false</selectable>
		<alwaysHaulable>false</alwaysHaulable>
		<smeltable>false</smeltable>
		<thingCategories>
			<li>Apparel</li>
		</thingCategories>
		<statBases>
			<Mass>0.1</Mass>
		</statBases>
		<graphicData>
			<texPath>DisguiseCostume/DisguiseCostume</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>1.2</drawSize>
		</graphicData>
		<apparel>
			<wornGraphicPath>DisguiseCostume/DisguiseCostume</wornGraphicPath>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Neck</li>
				<li>Shoulders</li>
			</bodyPartGroups>
			<layers>
				<li>SheepDisguiseShell</li>
			</layers>
		</apparel>
	</ThingDef>

	<!-- create disguise -->

	<JobDef>
		<defName>CreateSheepDisguise</defName>
		<driverClass>SheepHappens.JobDriver_SheepDisguise</driverClass>
		<reportString>creating disguise from</reportString>
		<allowOpportunisticPrefix>false</allowOpportunisticPrefix>
	</JobDef>

	<WorkGiverDef>
		<defName>SheepDisguise</defName>
		<label>create disguise</label>
		<giverClass>SheepHappens.WorkGiver_SheepDisguise</giverClass>
		<workType>Handling</workType>
		<scanThings>false</scanThings>
		<verb>create disguise</verb>
		<gerund>creating disguise from</gerund>
		<priorityInType>80</priorityInType>
		<tagToGive>Fieldwork</tagToGive>
		<requiredCapacities>
			<li>Manipulation</li>
		</requiredCapacities>
		<canBeDoneWhileDrafted>true</canBeDoneWhileDrafted>
	</WorkGiverDef>

	<!-- ignite -->

	<JobDef>
		<defName>IgniteSheepBomb</defName>
		<driverClass>SheepHappens.JobDriver_IgniteSheepBomb</driverClass>
		<reportString>igniting</reportString>
		<allowOpportunisticPrefix>false</allowOpportunisticPrefix>
	</JobDef>

	<WorkGiverDef>
		<defName>IgniteSheepBomb</defName>
		<label>create sheep bomb</label>
		<giverClass>SheepHappens.WorkGiver_IgniteSheepBomb</giverClass>
		<workType>Handling</workType>
		<scanThings>false</scanThings>
		<verb>ignite</verb>
		<gerund>igniting</gerund>
		<priorityInType>80</priorityInType>
		<tagToGive>Fieldwork</tagToGive>
		<requiredCapacities>
			<li>Manipulation</li>
		</requiredCapacities>
		<canBeDoneWhileDrafted>true</canBeDoneWhileDrafted>
	</WorkGiverDef>

	<!-- sheep bomb -->

	<JobDef>
		<defName>SheepBomb</defName>
		<driverClass>SheepHappens.JobDriver_SheepBomb</driverClass>
		<reportString>attacking nearest enemy</reportString>
		<allowOpportunisticPrefix>false</allowOpportunisticPrefix>
	</JobDef>

	<!-- damage -->

	<DamageDef ParentName="StunBase">
		<defName>ForcedSleep</defName>
		<label>sleep</label>
		<workerClass>SheepHappens.DamageWorker_ForcedSleep</workerClass>
		<deathMessage>{0} has been put to sleep.</deathMessage>
		<defaultDamage>0</defaultDamage>
		<explosionCellFleck>BlastDry</explosionCellFleck>
		<soundExplosion>SleepPuff</soundExplosion>
	</DamageDef>

	<!-- game condition -->

	<GameConditionDef>
		<defName>Sacrifice</defName>
		<conditionClass>SheepHappens.GameCondition_Sacrifice</conditionClass>
		<label>sacrificing sheep</label>
		<description>A sheep will be sacrified for making a sheep disguise.</description>
	</GameConditionDef>

	<!-- sounds -->

	<SoundDef>
		<defName>SleepPuff</defName>
		<context>MapOnly</context>
		<maxSimultaneous>2</maxSimultaneous>
		<subSounds>
			<li>
				<onCamera>true</onCamera>
				<grains>
					<li Class="AudioGrain_Clip">
						<clipPath>SleepBoom</clipPath>
					</li>
				</grains>
				<volumeRange>
					<min>90</min>
					<max>90</max>
				</volumeRange>
				<distRange>
					<min>1000</min>
					<max>10000</max>
				</distRange>
			</li>
		</subSounds>
	</SoundDef>

	<SoundDef>
		<defName>SacrificeSheep</defName>
		<context>MapOnly</context>
		<maxSimultaneous>2</maxSimultaneous>
		<subSounds>
			<li>
				<onCamera>true</onCamera>
				<grains>
					<li Class="AudioGrain_Clip">
						<clipPath>SacrificeSheep</clipPath>
					</li>
				</grains>
				<volumeRange>
					<min>75</min>
					<max>75</max>
				</volumeRange>
				<distRange>
					<min>1000</min>
					<max>10000</max>
				</distRange>
			</li>
		</subSounds>
	</SoundDef>

	<SoundDef>
		<defName>SheepIgnite</defName>
		<context>MapOnly</context>
		<maxSimultaneous>2</maxSimultaneous>
		<subSounds>
			<li>
				<onCamera>true</onCamera>
				<grains>
					<li Class="AudioGrain_Clip">
						<clipPath>SheepIgnite</clipPath>
					</li>
				</grains>
				<volumeRange>
					<min>90</min>
					<max>90</max>
				</volumeRange>
				<distRange>
					<min>1000</min>
					<max>10000</max>
				</distRange>
			</li>
		</subSounds>
	</SoundDef>

</Defs>
